---
import "@/styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Portfolio | Software Developer',
  description = 'A fast, static portfolio website built with Astro.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f1e8" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (() => {
        const key = "portfolio-theme";
        const stored = (() => {
          try {
            return localStorage.getItem(key);
          } catch {
            return null;
          }
        })();
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = stored === "dark" || stored === "light" ? stored : systemDark ? "dark" : "light";
        const root = document.documentElement;
        root.classList.toggle("dark", theme === "dark");
        root.dataset.theme = theme;
        root.style.colorScheme = theme;
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", theme === "dark" ? "#160f0c" : "#f7f1e8");
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      (() => {
        const key = "portfolio-theme";
        const buttons = document.querySelectorAll("[data-theme-toggle]");
        const meta = document.querySelector('meta[name="theme-color"]');

        const applyTheme = (theme) => {
          const root = document.documentElement;
          root.classList.toggle("dark", theme === "dark");
          root.dataset.theme = theme;
          root.style.colorScheme = theme;
          meta?.setAttribute("content", theme === "dark" ? "#160f0c" : "#f7f1e8");

          buttons.forEach((button) => {
            button.setAttribute("aria-pressed", String(theme === "dark"));
            const label = button.querySelector("[data-theme-label]");
            if (label) label.textContent = theme === "dark" ? "Dark" : "Light";
          });
        };

        const getTheme = () => {
          let stored = null;
          try {
            stored = localStorage.getItem(key);
          } catch {
            stored = null;
          }
          if (stored === "dark" || stored === "light") return stored;
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        };

        applyTheme(getTheme());

        buttons.forEach((button) => {
          button.addEventListener("click", () => {
            const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
            try {
              localStorage.setItem(key, nextTheme);
            } catch {
              // Theme still changes for the current page even if storage is unavailable.
            }
            applyTheme(nextTheme);
          });
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const drawer = document.querySelector("[data-nav-drawer]");
        const openButton = document.querySelector("[data-nav-open]");
        const closeTargets = document.querySelectorAll("[data-nav-close], [data-nav-link]");

        if (!drawer || !openButton) return;

        const setOpen = (isOpen) => {
          drawer.classList.toggle("hidden", !isOpen);
          openButton.setAttribute("aria-expanded", String(isOpen));
          document.body.style.overflow = isOpen ? "hidden" : "";
        };

        openButton.addEventListener("click", () => setOpen(true));
        closeTargets.forEach((target) => {
          target.addEventListener("click", () => setOpen(false));
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") setOpen(false);
        });

        window.matchMedia("(min-width: 768px)").addEventListener("change", (event) => {
          if (event.matches) setOpen(false);
        });
      })();
    </script>
  </body>
</html>
