---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Home from "@/components/Home.astro";
import AboutMe from "@/components/AboutMe.astro";
import WorkExperience from "@/components/WorkExperience.astro";
import Projects from "@/components/Projects.astro";
import Skills from "@/components/Skills.astro";
import ContactMe from "@/components/ContactMe.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
  title="Portfolio | Software Developer"
  description="A fast Astro portfolio for a software developer, including work, projects, skills, and contact details."
>
  <a
    class="fixed left-4 top-4 z-20 -translate-y-40 rounded-md bg-[var(--color-inverse)] px-4 py-3 text-[var(--color-inverse-text)] focus:translate-y-0"
    href="#main"
  >
    Skip to content
  </a>

  <Header />

  <main id="main">
    <Home />

    <AboutMe />

    <WorkExperience />

    <Projects />

    <Skills />

    <ContactMe />
  </main>

  <footer class="border-t border-[var(--color-line)] bg-[var(--color-surface)]">
    <Footer />
  </footer>
</Layout>
