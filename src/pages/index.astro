---
import Layout from "../layouts/Layout.astro";

const socials = [
  { label: "GitHub", href: "https://github.com/username" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/username" },
  { label: "Instagram", href: "https://instagram.com/username" },
  { label: "X", href: "https://x.com/username" },
];

const stats = [
  { value: "3+", label: "Years learning and building" },
  { value: "18", label: "Projects shipped" },
  { value: "9", label: "Core tools used weekly" },
  { value: "100%", label: "Static-first delivery" },
];

const descriptors = [
  {
    title: "Product-minded",
    text: "I connect technical choices with the user outcome, business goal, and long-term maintainability.",
  },
  {
    title: "Performance-aware",
    text: "I prefer lean interfaces, clear data flow, and static rendering whenever the experience allows it.",
  },
  {
    title: "Team-friendly",
    text: "I write readable code, document decisions, and keep communication practical from planning to release.",
  },
];

const experiences = [
  {
    period: "Jan 2025 - Present",
    role: "Frontend Developer",
    company: "Placeholder Studio",
    detail:
      "Built landing pages, dashboards, and reusable UI components with a focus on accessibility and fast delivery.",
  },
  {
    period: "Aug 2024 - Dec 2024",
    role: "Web Developer Intern",
    company: "Example Digital Lab",
    detail:
      "Supported client projects, converted designs into responsive pages, and improved API integration workflows.",
  },
  {
    period: "Feb 2023 - Jul 2024",
    role: "Freelance Developer",
    company: "Independent Projects",
    detail:
      "Delivered portfolio sites, admin pages, and small business websites using modern JavaScript tooling.",
  },
];

const projects = [
  {
    title: "Commerce Insight",
    tools: "Astro, TypeScript, Tailwind CSS",
    description:
      "A fast product analytics page for tracking catalog performance, campaign lift, and conversion signals.",
    goals:
      "Reduced layout weight, improved content clarity, and prepared the page for SEO-focused deployment.",
    image:
      "https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&w=900&q=70",
  },
  {
    title: "TeamFlow Dashboard",
    tools: "React, Node.js, PostgreSQL",
    description:
      "A project operations dashboard with task health, sprint notes, and team availability snapshots.",
    goals:
      "Created a cleaner decision surface for project leads and simplified weekly reporting.",
    image:
      "https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=900&q=70",
  },
  {
    title: "LearnTrack API",
    tools: "Laravel, MySQL, Redis",
    description:
      "A learning progress API for course enrollment, lesson completion, certificates, and admin review.",
    goals:
      "Improved response consistency, introduced cache-friendly endpoints, and documented integration flows.",
    image:
      "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=900&q=70",
  },
];

const skills = [
  {
    title: "Programming Languages",
    items: ["JavaScript", "TypeScript", "PHP", "Python", "SQL"],
  },
  {
    title: "Frameworks",
    items: ["Astro", "React", "Next.js", "Laravel", "Express"],
  },
  {
    title: "Databases",
    items: ["PostgreSQL", "MySQL", "MongoDB", "Redis"],
  },
  {
    title: "Tools",
    items: ["Git", "Docker", "Vercel", "Figma", "Postman"],
  },
];

const navItems = [
  { label: "About", href: "#about" },
  { label: "Experience", href: "#experience" },
  { label: "Projects", href: "#projects" },
  { label: "Skills", href: "#skills" },
  { label: "Contact", href: "#contact" },
];

const shell = "mx-auto w-[min(1120px,calc(100%_-_2rem))]";
const section = "py-16 md:py-24";
const eyebrow =
  "mb-4 w-fit rounded-full border border-[var(--color-line)] bg-[var(--color-accent-soft)] px-3 py-1 text-sm font-extrabold text-[var(--color-brand-strong)]";
const heading =
  "max-w-3xl text-3xl font-extrabold leading-tight text-[var(--color-text)] sm:text-4xl lg:text-5xl";
const card =
  "motion-card rounded-lg border border-[var(--color-line)] bg-[var(--color-surface)] shadow-[var(--shadow-card)]";
const primaryButton =
  "motion-sheen inline-flex min-h-11 items-center justify-center rounded-lg border border-transparent bg-[var(--color-brand)] px-4 py-3 font-extrabold text-white transition hover:-translate-y-0.5 hover:bg-[var(--color-brand-strong)] max-sm:w-full";
const secondaryButton =
  "inline-flex min-h-11 items-center justify-center rounded-lg border border-[var(--color-line)] bg-[var(--color-surface)] px-4 py-3 font-extrabold text-[var(--color-text)] transition hover:-translate-y-0.5 hover:bg-[var(--color-surface-strong)] max-sm:w-full";
---

<Layout
  title="Portfolio | Software Developer"
  description="A fast Astro portfolio for a software developer, including work, projects, skills, and contact details."
>
  <a
    class="fixed left-4 top-4 z-20 -translate-y-40 rounded-md bg-[var(--color-inverse)] px-4 py-3 text-[var(--color-inverse-text)] focus:translate-y-0"
    href="#main"
  >
    Skip to content
  </a>

  <header class="sticky top-0 z-10 border-b border-[var(--color-line)] bg-[rgb(var(--color-bg-rgb)/0.9)] backdrop-blur-md">
    <nav class={`${shell} flex min-h-[72px] items-center justify-between gap-4 py-4`} aria-label="Main navigation">
      <a class="text-lg font-extrabold text-[var(--color-text)]" href="#home" aria-label="Go to home">Portfolio.</a>
      <div class="hidden items-center justify-end gap-1 md:flex">
        {navItems.map((item) => (
          <a
            class="rounded-md px-3 py-2 text-sm font-bold text-[var(--color-muted)] hover:bg-[var(--color-surface-strong)] hover:text-[var(--color-text)]"
            href={item.href}
          >
            {item.label}
          </a>
        ))}
        <button
          class="inline-flex min-h-10 items-center gap-2 rounded-lg border border-[var(--color-line)] bg-[var(--color-surface)] px-3 py-2 text-sm font-extrabold text-[var(--color-text)] transition hover:bg-[var(--color-surface-strong)]"
          type="button"
          data-theme-toggle
          aria-pressed="false"
        >
          <span class="h-2.5 w-2.5 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
          <span>Theme:</span>
          <span data-theme-label>Light</span>
        </button>
      </div>
      <button
        class="inline-flex min-h-10 items-center gap-2 rounded-lg border border-[var(--color-line)] bg-[var(--color-surface)] px-3 py-2 text-sm font-extrabold text-[var(--color-text)] transition hover:bg-[var(--color-surface-strong)] md:hidden"
        type="button"
        data-nav-open
        aria-controls="mobile-navigation"
        aria-expanded="false"
      >
        <span class="grid gap-1" aria-hidden="true">
          <span class="block h-0.5 w-5 rounded-full bg-[var(--color-text)]"></span>
          <span class="block h-0.5 w-5 rounded-full bg-[var(--color-text)]"></span>
          <span class="block h-0.5 w-5 rounded-full bg-[var(--color-text)]"></span>
        </span>
        Menu
      </button>
    </nav>
  </header>

  <div class="fixed inset-0 z-50 hidden md:hidden" id="mobile-navigation" data-nav-drawer>
    <button
      class="absolute inset-0 bg-[rgb(0_0_0/0.45)]"
      type="button"
      data-nav-close
      aria-label="Close navigation"
    ></button>
    <aside
      class="absolute right-0 top-0 flex h-full w-[min(360px,calc(100%_-_2rem))] flex-col border-l border-[var(--color-line)] bg-[var(--color-surface)] p-5 text-[var(--color-text)] shadow-[var(--shadow-lift)]"
      aria-label="Mobile navigation"
      data-nav-panel
    >
      <div class="flex items-center justify-between gap-4">
        <a class="text-lg font-extrabold" href="#home" data-nav-link>Portfolio.</a>
        <button
          class="inline-flex min-h-10 items-center justify-center rounded-lg border border-[var(--color-line)] px-3 py-2 font-extrabold hover:bg-[var(--color-surface-strong)]"
          type="button"
          data-nav-close
          aria-label="Close navigation"
        >
          Close
        </button>
      </div>

      <div class="mt-8 grid gap-2">
        {navItems.map((item) => (
          <a
            class="rounded-lg px-3 py-3 text-lg font-extrabold text-[var(--color-text)] hover:bg-[var(--color-surface-strong)]"
            href={item.href}
            data-nav-link
          >
            {item.label}
          </a>
        ))}
      </div>

      <button
        class="mt-8 inline-flex min-h-11 items-center justify-center gap-2 rounded-lg border border-[var(--color-line)] bg-[var(--color-surface-strong)] px-4 py-3 font-extrabold text-[var(--color-text)]"
        type="button"
        data-theme-toggle
        aria-pressed="false"
      >
        <span class="h-2.5 w-2.5 rounded-full bg-[var(--color-accent)]" aria-hidden="true"></span>
        <span>Theme:</span>
        <span data-theme-label>Light</span>
      </button>
    </aside>
  </div>

  <main id="main">
    <section id="home" class={`${section} relative overflow-hidden pt-12 md:pt-20`}>
      <div class="motion-steam" aria-hidden="true">
        {Array.from({ length: 22 }).map(() => <span></span>)}
      </div>
      <div class={`${shell} relative z-[1] grid items-center gap-8 md:gap-12 lg:grid-cols-[1.08fr_0.72fr]`}>
        <div class="max-w-3xl">
          <p class={`${eyebrow} motion-fade-up`}>Available for web projects</p>
          <h1 class="motion-fade-up max-w-3xl text-3xl font-extrabold leading-tight text-[var(--color-text)] sm:text-4xl lg:text-6xl">
            Hi, I am Your Name, a developer who builds fast and useful web experiences.
          </h1>
          <p class="motion-fade-up motion-delay-1 mt-5 max-w-2xl text-base text-[var(--color-muted)] sm:text-lg">
            I turn ideas into clean interfaces, reliable systems, and static-first websites that feel quick from the first click.
          </p>
          <p class="motion-fade-up motion-delay-2 mt-5 inline-flex border-l-4 border-[var(--color-accent)] bg-[var(--color-surface)] px-4 py-3 text-base font-extrabold text-[var(--color-text)] shadow-[var(--shadow-lift)]">
            <span class="motion-typewriter">Ship with clarity. Scale with care.</span>
          </p>
          <div class="motion-fade-up motion-delay-3 mt-8 flex flex-wrap gap-3" aria-label="Primary actions">
            <a class={primaryButton} href="#projects">View Projects</a>
            <a class={secondaryButton} href="#contact">Get In Touch</a>
          </div>
          <ul class="motion-fade-up motion-delay-4 mt-6 flex flex-wrap gap-3" aria-label="Social media links">
            {socials.map((social) => (
              <li>
                <a
                  class="font-extrabold text-[var(--color-brand-strong)] underline decoration-2 underline-offset-4"
                  href={social.href}
                  target="_blank"
                  rel="noreferrer"
                >
                  {social.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <figure class="motion-fade-scale motion-delay-2 mx-auto w-full max-w-[320px] sm:max-w-sm lg:max-w-none">
          <img
            class="motion-float aspect-[4/3] w-full rounded-lg object-cover shadow-[var(--shadow-lift)] lg:aspect-[4/5]"
            src="Engineer in the code chaos.png"
            alt="Developer desk with laptop and code editor"
            width="900"
            height="1125"
            decoding="async"
            fetchpriority="high"
          />
          <figcaption class="mt-3 text-sm text-[var(--color-muted)]">Focused on Astro, clean UI, and fast delivery.</figcaption>
        </figure>
      </div>
    </section>

    <section id="about" class={`${section} motion-reveal bg-[var(--color-surface)]`}>
      <div class={shell}>
        <div class="mb-8">
          <p class={eyebrow}>About Me</p>
          <h2 class={heading}>Curious builder, practical problem solver.</h2>
        </div>

        <div class="grid items-start gap-8 lg:grid-cols-[1fr_0.8fr]">
          <div class="text-lg text-[var(--color-muted)]">
            <p>
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer viverra, sem in porta elementum, erat
              massa eleifend turpis, sed dictum risus mi vitae arcu. I enjoy shaping digital products from rough notes
              into polished, maintainable releases.
            </p>
            <p class="mt-4">
              Praesent tincidunt, justo at posuere feugiat, erat mi dapibus mi, non tempor lectus metus at nisl. I care
              about good naming, simple architecture, accessible interfaces, and performance that users can actually feel.
            </p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2" aria-label="Developer stats">
            {stats.map((stat) => (
              <article class={`${card} min-h-32 p-5`}>
                <strong class="block text-4xl leading-none text-[var(--color-accent)]">{stat.value}</strong>
                <span class="mt-3 block font-bold text-[var(--color-muted)]">{stat.label}</span>
              </article>
            ))}
          </div>
        </div>

        <div class="mt-4 grid gap-4 md:grid-cols-3">
          {descriptors.map((item) => (
            <article class={`${card} bg-[var(--color-surface-muted)] p-5`}>
              <h3 class="text-xl font-extrabold leading-tight text-[var(--color-text)]">{item.title}</h3>
              <p class="mt-3 text-[var(--color-muted)]">{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="experience" class={`${section} motion-reveal`}>
      <div class={shell}>
        <div class="mb-8">
          <p class={eyebrow}>Work Experience</p>
          <h2 class={heading}>A timeline of steady practice and shipped work.</h2>
        </div>

        <div class="motion-rail relative grid gap-6 pl-8 before:absolute before:left-3 before:top-0 before:h-full before:w-[3px] before:bg-[var(--color-brand)] md:gap-8 md:pl-0 md:before:left-1/2 md:before:-translate-x-1/2">
          {experiences.map((item, index) => {
            const isLeft = index % 2 === 0;
            const cardPosition = isLeft ? "md:col-start-1 md:text-right" : "md:col-start-3";
            const connectorPosition = isLeft ? "md:right-1/2 md:mr-2" : "md:left-1/2 md:ml-2";

            return (
              <article class="relative grid items-center gap-4 md:grid-cols-[1fr_64px_1fr]">
                <div class={`${card} ${cardPosition} p-5`}>
                  <time class="font-black text-[var(--color-brand-strong)]">{item.period}</time>
                  <h3 class="mt-3 text-xl font-extrabold leading-tight text-[var(--color-text)]">{item.role}</h3>
                  <p class="mt-2 font-extrabold text-[var(--color-text)]">{item.company}</p>
                  <p class="mt-2 text-[var(--color-muted)]">{item.detail}</p>
                </div>

                <span
                  class="motion-dot absolute -left-[31px] top-6 h-4 w-4 rounded-full border-[3px] border-[var(--color-bg)] bg-[var(--color-accent)] md:left-1/2 md:top-1/2 md:-translate-x-1/2 md:-translate-y-1/2"
                  aria-hidden="true"
                ></span>
                <span
                  class={`hidden md:block md:absolute md:top-1/2 md:h-[3px] md:w-8 md:-translate-y-1/2 md:bg-[var(--color-brand)] ${connectorPosition}`}
                  aria-hidden="true"
                ></span>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section id="projects" class={`${section} motion-reveal bg-[var(--color-surface)]`}>
      <div class={shell}>
        <div class="mb-8">
          <p class={eyebrow}>Project Experience</p>
          <h2 class={heading}>Selected builds with clear goals and measurable outcomes.</h2>
        </div>

        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => (
            <article class={`${card} overflow-hidden bg-[var(--color-surface-muted)]`}>
              <img
                class="aspect-[3/2] w-full object-cover"
                src={project.image}
                alt=""
                width="900"
                height="600"
                loading="lazy"
                decoding="async"
              />
              <div class="p-5">
                <p class="mb-3 text-sm font-black text-[var(--color-accent)]">{project.tools}</p>
                <h3 class="text-xl font-extrabold leading-tight text-[var(--color-text)]">{project.title}</h3>
                <p class="mt-3 text-[var(--color-muted)]">{project.description}</p>
                <p class="mt-3 text-[var(--color-muted)]"><strong>Goals and achievement:</strong> {project.goals}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="skills" class={`${section} motion-reveal`}>
      <div class={shell}>
        <div class="mb-8">
          <p class={eyebrow}>Technical Skills</p>
          <h2 class={heading}>The tools I use to design, build, and ship dependable products.</h2>
        </div>

        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
          {skills.map((group) => (
            <article class={`${card} p-5`}>
              <h3 class="text-xl font-extrabold leading-tight text-[var(--color-text)]">{group.title}</h3>
              <ul class="mt-4 flex flex-wrap gap-2">
                {group.items.map((skill) => (
                  <li class="rounded-full border border-[var(--color-line)] bg-[var(--color-surface-strong)] px-3 py-1 text-sm font-extrabold text-[var(--color-muted)]">
                    {skill}
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class={`${section} motion-reveal bg-[var(--color-contact-bg)] text-[var(--color-contact-text)]`}>
      <div class={`${shell} grid items-start gap-8 lg:grid-cols-[1fr_420px]`}>
        <div class="max-w-3xl">
          <p class={`${eyebrow} border-[var(--color-contact-line)]`}>Get In Touch</p>
          <h2 class="max-w-3xl text-3xl font-extrabold leading-tight text-[var(--color-contact-text)] sm:text-4xl">
            Have an idea, role, or collaboration in mind?
          </h2>
          <p class="mt-5 max-w-2xl text-base text-[var(--color-contact-muted)] sm:text-lg">
            Send a short message about what you want to build, improve, or launch. I will reply with a clear next step
            and a practical way to move forward.
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            <span class="rounded-full border border-[var(--color-contact-line)] bg-[var(--color-contact-panel)] px-3 py-1 text-sm font-extrabold">
              Open for freelance
            </span>
            <span class="rounded-full border border-[var(--color-contact-line)] bg-[var(--color-contact-panel)] px-3 py-1 text-sm font-extrabold">
              Remote friendly
            </span>
          </div>
        </div>

        <div class="grid gap-4 rounded-lg border border-[var(--color-contact-line)] bg-[var(--color-contact-panel)] p-4 shadow-[var(--shadow-card)] sm:p-5" aria-label="Contact information">
          <a
            class="motion-sheen inline-flex min-h-10 w-full items-center justify-center rounded-lg border border-transparent bg-[var(--color-brand)] px-3 py-2 text-sm font-extrabold text-white transition hover:-translate-y-0.5 hover:bg-[var(--color-brand-strong)] sm:min-h-11 sm:px-4 sm:py-3 sm:text-base"
            href="/resume-placeholder.pdf"
            download
          >
            Download Resume PDF
          </a>

          <a
            class="rounded-lg border border-[var(--color-contact-line)] px-4 py-3 transition hover:bg-[var(--color-surface-strong)]"
            href="mailto:hello@example.com"
          >
            <span class="block text-xs font-black uppercase tracking-wide text-[var(--color-contact-muted)]">Email</span>
            <span class="mt-1 block font-extrabold text-[var(--color-contact-text)] underline decoration-2 underline-offset-4">
              hello@example.com
            </span>
          </a>

          <a
            class="rounded-lg border border-[var(--color-contact-line)] px-4 py-3 transition hover:bg-[var(--color-surface-strong)]"
            href="https://wa.me/6281234567890"
            target="_blank"
            rel="noreferrer"
          >
            <span class="block text-xs font-black uppercase tracking-wide text-[var(--color-contact-muted)]">WhatsApp</span>
            <span class="mt-1 block font-extrabold text-[var(--color-contact-text)] underline decoration-2 underline-offset-4">
              +62 812 3456 7890
            </span>
          </a>

          <p class="text-sm text-[var(--color-contact-muted)]">
            Prefer email for project briefs, WhatsApp for quick availability checks.
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-[var(--color-line)] px-4 py-6 text-center text-[var(--color-muted)]">
    <p>Built with Astro and Tailwind CSS. Static, focused, and ready to customize.</p>
  </footer>
</Layout>
