---
import { shell } from "@/components/style";
---

<div
  class={`${shell} grid gap-6 py-8 sm:py-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-end`}
>
  <div>
    <p class="text-lg font-extrabold text-[var(--color-text)]">Portfolio.</p>
    <p
      class="mt-3 max-w-2xl text-sm leading-7 text-[var(--color-muted)] sm:text-base"
    >
      Have a fintech idea, backend system, or API product to build? I help teams
      ship practical systems with clear architecture and reliable execution.
    </p>
    <div class="mt-4 flex flex-wrap gap-2">
      <span
        class="rounded-full border border-[var(--color-line)] bg-[var(--color-surface-strong)] px-3 py-1 text-xs font-extrabold text-[var(--color-muted)] sm:text-sm"
      >
        Open for backend roles
      </span>
      <span
        class="rounded-full border border-[var(--color-line)] bg-[var(--color-surface-strong)] px-3 py-1 text-xs font-extrabold text-[var(--color-muted)] sm:text-sm"
      >
        Fintech & API systems
      </span>
      <span
        class="rounded-full border border-[var(--color-line)] bg-[var(--color-surface-strong)] px-3 py-1 text-xs font-extrabold text-[var(--color-muted)] sm:text-sm"
      >
        Remote friendly
      </span>
    </div>
  </div>

  <div class="grid gap-3 text-left lg:justify-items-end lg:text-right">
    <a
      class="inline-flex w-fit items-center rounded-lg border border-[var(--color-line)] px-3 py-2 text-sm font-extrabold text-[var(--color-text)] transition hover:bg-[var(--color-surface-strong)]"
      href="#home"
    >
      Back to top
    </a>
    <p class="text-sm text-[var(--color-muted)]">
      Designed and built by Norbertus Dewa Rucci.
    </p>
    <p class="text-sm text-[var(--color-muted)]">
      Backend engineer focused on fintech and scalable systems.
    </p>
  </div>
</div>
