---
import { shell, eyebrow, heading, section, card } from "@/components/style";

const stats = [
  { value: "2+ Years", label: "Building fintech & enterprise systems" },
  { value: "5+ Systems", label: "Payment & enterprise platforms" },
  { value: "Secure APIs", label: "JWT, HMAC, Webhook integration" },
  // { value: "High-scale", label: "Data & performance optimization" },
  { value: "Microservices", label: "Architecture & API design" },
];

const descriptors = [
  {
    title: "System-oriented",
    text: "I design backend systems with scalability, reliability, and real-world usage in mind, not just features.",
  },
  {
    title: "Performance-driven",
    text: "I optimize queries, data flow, and services to handle large-scale data and high-load systems efficiently.",
  },
  {
    title: "Production-focused",
    text: "I write clean, maintainable code and build systems that are ready for real users, monitoring, and scaling.",
  },
];
---

<section
  id="about"
  class={`${section} motion-reveal bg-[var(--color-surface)]`}
>
  <div class={shell}>
    <div class="mb-8">
      <p class={eyebrow}>About Me</p>
      <h2 class={heading}>Backend engineer, system thinker, problem solver.</h2>
    </div>

    <div class="grid items-start gap-8 lg:grid-cols-[1fr_0.8fr]">
      <div class="text-lg text-[var(--color-muted)]">
        <p>
          I build backend systems that power real-world applications, from
          payment gateways and merchant integrations to enterprise platforms.
        </p>

        <p class="mt-4">
          My focus is on designing scalable architectures, secure APIs, and
          reliable data flows that can handle real transactions and real users.
          I enjoy working on complex systems, especially where modern
          applications need to integrate with legacy infrastructure.
        </p>
        <p class="mt-4">
          I care about clean architecture, system performance, and building
          services that are maintainable, observable, and production-ready.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2" aria-label="Developer stats">
        {
          stats.map((stat) => (
            <article class={`${card} min-h-32 p-5`}>
              <strong class="block text-2xl leading-none text-[var(--color-accent)]">
                {stat.value}
              </strong>
              <span class="mt-3 block font-bold text-[var(--color-muted)]">
                {stat.label}
              </span>
            </article>
          ))
        }
      </div>
    </div>

    <div class="mt-4 grid gap-4 md:grid-cols-3">
      {
        descriptors.map((item) => (
          <article class={`${card} bg-[var(--color-surface-muted)] p-5`}>
            <h3 class="text-xl font-extrabold leading-tight text-[var(--color-text)]">
              {item.title}
            </h3>
            <p class="mt-3 text-[var(--color-muted)]">{item.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
