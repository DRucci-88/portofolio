---
import { shell, eyebrow, heading, section, card } from "@/components/style";

const skills = [
  {
    title: "Programming Languages",
    items: ["JavaScript", "TypeScript", "PHP", "JAVA"],
  },
  {
    title: "Frameworks",
    items: ["Nest.JS", "React", "Next.js", "Laravel", "Astro", "Spring Boot"],
  },
  {
    title: "Databases",
    items: ["PostgreSQL", "MySQL", ],
  },
  {
    title: "Architecture & Concepts",
    items: [
      "Microservices",
      "REST API",
      "API Security (JWT, HMAC)",
      "Webhook",
      "System Integration",
    ],
  },
  {
    title: "Tools & Platform",
    items: ["Docker", "Git", "Postman", "Swagger", "WebLogic"],
  },
];
---

<section id="skills" class={`${section} motion-reveal`}>
  <div class={shell}>
    <div class="mb-8">
      <p class={eyebrow}>Technical Skills</p>
      <h2 class="max-w-4xl text-3xl font-extrabold leading-tight text-[var(--color-text)] sm:text-4xl lg:text-5xl">
        Technologies I use to build scalable backend systems and fintech
        platforms.
      </h2>
      <p class="mt-4 max-w-3xl text-lg font-bold leading-relaxed text-[var(--color-muted)] sm:text-xl">
        Payment Systems, Merchant Integration, Settlement & Reconciliation,
        Legacy System Integration
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        skills.map((group) => (
          <article class={`${card} p-5`}>
            <h3 class="text-xl font-extrabold leading-tight text-[var(--color-text)]">
              {group.title}
            </h3>
            <ul class="mt-4 flex flex-wrap gap-2">
              {group.items.map((skill) => (
                <li class="rounded-full border border-[var(--color-line)] bg-[var(--color-surface-strong)] px-3 py-1 text-sm font-extrabold text-[var(--color-muted)]">
                  {skill}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
