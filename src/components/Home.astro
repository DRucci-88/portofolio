---
import {
  shell,
  eyebrow,
  primaryButton,
  secondaryButton,
  section,
} from "@/components/style";

const socials = [
  { label: "GitHub", href: "https://github.com/DRucci-88" },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/norbertus-dewa-rucci/",
  },
  { label: "Instagram", href: "https://www.instagram.com/ewarucci" },
];
---

<section id="home" class={`${section} relative overflow-hidden pt-12 md:pt-20`}>
  <div class="motion-steam" aria-hidden="true">
    {Array.from({ length: 22 }).map(() => <span />)}
  </div>
  <div
    class={`${shell} relative z-[1] grid items-center gap-8 md:gap-12 lg:grid-cols-[1.08fr_0.72fr]`}
  >
    <div class="max-w-3xl">
      <p class={`${eyebrow} motion-fade-up`}>Available for web projects</p>
      <h1
        class="motion-fade-up max-w-3xl text-3xl font-extrabold leading-tight text-[var(--color-text)] sm:text-4xl lg:text-6xl"
      >
        Hi, I am Norbertus Dewa Rucci, a backend engineer turning complex
        systems into simple, reliable solutions.
      </h1>
      <p
        class="motion-fade-up motion-delay-1 mt-5 max-w-2xl text-base text-[var(--color-muted)] sm:text-lg"
      >
        I design secure APIs, payment workflows, and microservices that power
        real-world applications at scale. I focus on performance, security, and clean architecture.
      </p>
      <p
        class="motion-fade-up motion-delay-2 mt-5 inline-flex border-l-4 border-[var(--color-accent)] bg-[var(--color-surface)] px-4 py-3 text-base font-extrabold text-[var(--color-text)] shadow-[var(--shadow-lift)]"
      >
        <span class="motion-typewriter">Build secure. Scale smart.</span>
      </p>
      <div
        class="motion-fade-up motion-delay-3 mt-8 flex flex-wrap gap-3"
        aria-label="Primary actions"
      >
        <a class={primaryButton} href="#projects">View Projects</a>
        <a class={secondaryButton} href="#contact">Get In Touch</a>
      </div>
      <ul
        class="motion-fade-up motion-delay-4 mt-6 flex flex-wrap gap-3"
        aria-label="Social media links"
      >
        {
          socials.map((social) => (
            <li>
              <a
                class="font-extrabold text-[var(--color-brand-strong)] underline decoration-2 underline-offset-4"
                href={social.href}
                target="_blank"
                rel="noreferrer"
              >
                {social.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <figure
      class="motion-fade-scale motion-delay-2 mx-auto w-full max-w-[320px] sm:max-w-sm lg:max-w-none"
    >
      <img
        class="motion-float aspect-[4/3] w-full rounded-lg object-cover shadow-[var(--shadow-lift)] lg:aspect-[4/5]"
        src="/portofolio/Engineer in the code chaos.png"
        alt="Developer desk with laptop and code editor"
        width="900"
        height="1125"
        decoding="async"
        fetchpriority="high"
      />
      <figcaption class="mt-3 text-sm text-[var(--color-muted)]">
        Enjoy morning coffee daily
      </figcaption>
    </figure>
  </div>
</section>
